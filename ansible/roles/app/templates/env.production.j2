# Rendered by Ansible (role: app). Do not edit on the server
NODE_ENV=production
PORT={{ app_port }}
LOG_LEVEL={{ app_log_level }}

DATABASE_URL="postgres://{{ postgres_user }}:{{ vault_postgres_password }}@db:5432/{{ postgres_db }}"

VALKEY_HOST={{ valkey_host }}
VALKEY_PORT={{ valkey_port }}

JWT_SECRET="{{ vault_jwt_secret }}"
FRONTEND_URL="{{ app_frontend_url }}"

RESEND_API_KEY="{{ vault_resend_api_key }}"
RESEND_FROM="{{ resend_from }}"

S3_REGION="{{ s3_region }}"
S3_URL="{{ s3_url }}"
S3_ACCESS_KEY="{{ vault_s3_access_key }}"
S3_ACCESS_SECRET="{{ vault_s3_access_secret }}"
S3_BUCKET="{{ s3_bucket }}"
