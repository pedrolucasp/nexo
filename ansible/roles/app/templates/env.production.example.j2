# Copy to `.env.production`. Loaded by the api container (env_file)
# NEVER commit the filled-in file

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database (must match POSTGRES_* in .env)
DATABASE_URL="postgres://orbit:change-me@db:5432/orbit_production"

# Queue / cache
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Auth
JWT_SECRET="change-me"

# CORS / public URL
FRONTEND_URL="https://usenexo.xyz"

# Email (Resend)
RESEND_API_KEY="xxxxxx"
RESEND_FROM="orbit <noreply@example.com>"

# Object storage (avatars, S3-compatible)
S3_REGION=""
S3_URL=""
S3_ACCESS_KEY=""
S3_ACCESS_SECRET=""
S3_BUCKET=""

# Image tag — set by CI, or pin manually
GITHUB_REPOSITORY=pedrolucasp/nexo
IMAGE_TAG=latest

# Logging stack (VictoriaLogs + Vector)
VICTORIALOGS_TAG=v1.53.0
VICTORIALOGS_PORT=9428
VICTORIALOGS_RETENTION=14d
VICTORIALOGS_MAX_DISK=2GiB
VECTOR_TAG=0.59.X-distroless-libc

# Container log rotation (json-file driver)
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
