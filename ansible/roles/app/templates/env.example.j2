# Copy to `.env` in the same directory. `docker compose` loads it automatically
# to interpolate the ${...} variables used in docker-compose.yml
# NEVER commit the filled-in file!

POSTGRES_USER=orbit
POSTGRES_DB=orbit_production
POSTGRES_PASSWORD=change-me

# ghcr.io/<owner>/<repo> must match the image the deploy workflow pushes
GITHUB_REPOSITORY={{ app_github_repo }}

# CI rewrites IMAGE_TAG on every deploy
IMAGE_TAG=latest
