# Bundle-time env for Expo (inlined by Metro; keep values device-reachable).
# Copy to .env.local (gitignored) or export before `npx expo start`.
#
# Never put a secret here: EXPO_PUBLIC_* ends up inside the shipped JS bundle.
#
# Optional in development. When unset, the app derives the API host from the
# Metro server it is already talking to (localhost under `npm run
# android:reverse`, otherwise the LAN IP) and assumes port 3000. Release builds
# have no Metro host, so they need this set per EAS environment instead.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
# SecureStore key under which the JWT is persisted.
EXPO_PUBLIC_TOKEN_KEY=orbit-jwt